# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL=gemini-2.0-flash

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Groq is used only by the server-side gateway report narrative endpoint.
# Copy this file to .env and set the key locally; never commit the real key.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Select the report narrative provider: gemini, openai, llm7, or groq.
LLM_PROVIDER=gemini

# Optional OpenAI-compatible LLM7 provider for AI report prose. Keep this key
# server-side only; set LLM_PROVIDER=llm7 to select it over Groq.
LLM7_API_KEY=
LLM7_MODEL=default

# Optional OpenAI provider for AI report prose. Do not put this key in browser
# code or commit it. Select it with LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Enables browser-requested StrongSwan testbed jobs; use a random local-only token.
VPN_ANALYZER_TESTBED_TOKEN=
